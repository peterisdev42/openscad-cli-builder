diff --git a/src/platform/WindowsPath.h b/src/platform/WindowsPath.h
new file mode 100644
index 0000000000000000000000000000000000000000..bca5449858659ae1ff2c29321a26b8a92eb33c4a
--- /dev/null
+++ b/src/platform/WindowsPath.h
@@ -0,0 +1,21 @@
+#pragma once
+
+#include <boost/nowide/convert.hpp>
+#include <filesystem>
+#include <string>
+
+namespace WindowsPath {
+
+// OpenSCAD's CLI, parser and library strings contain UTF-8.
+// MSVC's path::string() and path::generic_string() use a locale code page.
+inline std::string utf8(const std::filesystem::path& path)
+{
+  return boost::nowide::narrow(path.wstring());
+}
+
+inline std::string genericUtf8(const std::filesystem::path& path)
+{
+  return boost::nowide::narrow(path.generic_wstring());
+}
+
+}
